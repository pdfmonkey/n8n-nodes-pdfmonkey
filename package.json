{
  "name": "n8n-nodes-pdfmonkey",
  "version": "1.0.0",
  "description": "PDFMonkey nodes for n8n",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pdfmonkey/n8n-nodes-pdfmonkey",
  "author": {
    "name": "PDFMonkey",
    "email": "tinymonkey@pdfmonkey.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pdfmonkey/n8n-nodes-pdfmonkey"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3",
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "pnpm build && pnpm lint -c eslint.config.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PdfMonkeyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PdfMonkey/PdfMonkey.node.js",
      "dist/nodes/PdfMonkey/PdfMonkeyTrigger.node.js"
    ],
    "versionId": "1.0.0",
    "categories": [
      "Development",
      "Files"
    ],
    "icon": "file:PDFMonkey.svg"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "gulp": "^5.0.1",
    "n8n-workflow": "^2.28.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
